<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.intellitransit.controller.PassengerDashboardController"
      spacing="20" styleClass="root" stylesheets="@../css/styles.css">

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        
        <!-- Tab 1: Route Search & Booking -->
        <Tab text="Book Journey &amp; Fares">
            <HBox spacing="20">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <!-- Left Form Card -->
                <VBox spacing="15" prefWidth="420" styleClass="card">
                    <Text text="Plan Your Trip" styleClass="text-title"/>
                    
                    <VBox spacing="5">
                        <Label text="Select Route" styleClass="text-subtitle"/>
                        <ComboBox fx:id="routeComboBox" promptText="Choose a route" maxWidth="INFINITY"/>
                    </VBox>

                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Boarding Stop" styleClass="text-subtitle"/>
                            <ComboBox fx:id="originStopCombo" promptText="Origin" maxWidth="INFINITY"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Destination Stop" styleClass="text-subtitle"/>
                            <ComboBox fx:id="destStopCombo" promptText="Destination" maxWidth="INFINITY"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="Passenger Category" styleClass="text-subtitle"/>
                        <ComboBox fx:id="categoryCombo" maxWidth="INFINITY"/>
                    </VBox>

                    <Button text="Calculate Fare Preview" onAction="#handleCalculateFare"
                            styleClass="btn-secondary" maxWidth="INFINITY"/>

                    <Separator/>

                    <VBox spacing="5">
                        <Label text="Select Available Trip" styleClass="text-subtitle"/>
                        <ComboBox fx:id="tripComboBox" promptText="Choose scheduled trip" maxWidth="INFINITY"/>
                    </VBox>

                    <Button text="Book Ticket Now" onAction="#handleBookTicket"
                            styleClass="btn-primary" maxWidth="INFINITY"/>

                    <Label fx:id="bookingStatusLabel" wrapText="true" alignment="CENTER" maxWidth="INFINITY"/>
                </VBox>

                <!-- Right Fare Details Card -->
                <VBox spacing="20" HBox.hgrow="ALWAYS" styleClass="card-highlight">
                    <Text text="Fare Summary &amp; Slab Breakdown" styleClass="text-title"/>
                    
                    <GridPane hgap="15" vgap="15">
                        <Label text="Distance Slab Base Fare:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="text-subtitle"/>
                        <Label fx:id="baseFareLabel" text="$0.00" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="text-title"/>

                        <Label text="Category Discount:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="text-subtitle"/>
                        <Label fx:id="discountLabel" text="0%" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="text-title" style="-fx-text-fill: #34D399;"/>

                        <Label text="Total Payable Fare:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="text-title"/>
                        <Label fx:id="finalFareLabel" text="$0.00" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="text-header" style="-fx-fill: #6366F1;"/>
                    </GridPane>

                    <Text text="* Slabs are based on exact distance between route stop sequences. Student (20%) and Senior (30%) discounts are automatically applied."
                          styleClass="text-subtitle" wrapText="true"/>
                </VBox>
            </HBox>
        </Tab>

        <!-- Tab 2: My Bookings & QR Ticket -->
        <Tab text="My Digital Tickets &amp; QR">
            <HBox spacing="20">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <!-- Bookings Table -->
                <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="card">
                    <Text text="My Active &amp; Past Bookings" styleClass="text-title"/>
                    <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colRef" text="Booking Ref" prefWidth="110"/>
                            <TableColumn fx:id="colRoute" text="Route" prefWidth="80"/>
                            <TableColumn fx:id="colFrom" text="Origin" prefWidth="120"/>
                            <TableColumn fx:id="colTo" text="Destination" prefWidth="120"/>
                            <TableColumn fx:id="colFare" text="Fare" prefWidth="80"/>
                            <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Dynamic QR Ticket Card -->
                <VBox alignment="CENTER" spacing="15" prefWidth="340" styleClass="card-highlight">
                    <Text text="Digital QR Boarding Pass" styleClass="text-title"/>
                    <ImageView fx:id="qrImageView" fitWidth="220" fitHeight="220" preserveRatio="true"/>
                    <Label fx:id="qrTicketNumLabel" text="Select a booking row to view QR" styleClass="text-title"/>
                    <Label fx:id="qrStatusLabel" styleClass="status-pill-active"/>
                </VBox>
            </HBox>
        </Tab>

        <!-- Tab 3: Submit Complaint -->
        <Tab text="Passenger Support &amp; Complaints">
            <VBox spacing="15" styleClass="card" maxWidth="600">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                
                <Text text="File a Service Feedback or Complaint" styleClass="text-title"/>

                <VBox spacing="5">
                    <Label text="Subject" styleClass="text-subtitle"/>
                    <TextField fx:id="complaintSubjectField" promptText="Brief summary of issue"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Category" styleClass="text-subtitle"/>
                    <ComboBox fx:id="complaintCategoryCombo" maxWidth="INFINITY"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Description" styleClass="text-subtitle"/>
                    <TextArea fx:id="complaintDescArea" prefRowCount="4" promptText="Describe what happened in detail..."/>
                </VBox>

                <Button text="Submit Feedback" onAction="#handleSubmitComplaint" styleClass="btn-primary"/>
                <Label fx:id="complaintStatusLabel"/>
            </VBox>
        </Tab>

    </TabPane>
</VBox>
