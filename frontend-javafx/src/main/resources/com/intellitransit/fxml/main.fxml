<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.intellitransit.controller.MainController"
            stylesheets="@../css/styles.css"
            prefWidth="1280.0" prefHeight="800.0">

    <!-- Top Header -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="2">
                <Label text="INTELLITRANSIT" styleClass="brand-title"/>
                <Label text="Smart Urban Transport &amp; AI Operational Intelligence Platform" styleClass="brand-subtitle"/>
            </VBox>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" text="System Online • Service Version 1.0.0" styleClass="badge-success"/>
        </HBox>
    </top>

    <!-- Navigation Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="10">
            <Label text="NAVIGATION" style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: bold;">
                <VBox.margin>
                    <Insets top="10" bottom="5" left="8"/>
                </VBox.margin>
            </Label>
            <Button text="📊 Operations Dashboard" styleClass="nav-button, active" maxWidth="INFINITY"/>
            <Button text="🚍 Fleet &amp; Buses" styleClass="nav-button" maxWidth="INFINITY"/>
            <Button text="🗺️ Routes &amp; Stops" styleClass="nav-button" maxWidth="INFINITY"/>
            <Button text="🎫 Ticket Booking" styleClass="nav-button" maxWidth="INFINITY"/>
            <Button text="📍 Trip Logs &amp; Incidents" styleClass="nav-button" maxWidth="INFINITY"/>
            <Button text="🤖 AI Alerts &amp; Anomalies" styleClass="nav-button" maxWidth="INFINITY"/>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <VBox spacing="20" style="-fx-padding: 24;">
            <!-- Welcome Header Card -->
            <VBox styleClass="card-panel" spacing="8">
                <Label text="Project Foundation Ready" styleClass="card-title"/>
                <Label text="Welcome to IntelliTransit Platform. Architecture modules and dependencies are successfully initialized."
                       style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;" wrapText="true"/>
            </VBox>

            <!-- Status KPI Cards Grid -->
            <HBox spacing="20">
                <VBox styleClass="card-panel" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="System Modules" styleClass="card-subtext"/>
                    <Label text="6 Active" styleClass="card-value"/>
                    <Label text="Backend, Frontend, AI Service, DB" style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
                </VBox>

                <VBox styleClass="card-panel" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Database Tables" styleClass="card-subtext"/>
                    <Label text="14 Defined" styleClass="card-value"/>
                    <Label text="Relational Schema Ready" style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
                </VBox>

                <VBox styleClass="card-panel" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="AI Engine" styleClass="card-subtext"/>
                    <Label text="Isolation Forest" styleClass="card-value"/>
                    <Label text="FastAPI Skeleton Configured" style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
